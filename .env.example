# Copy this file to .env and fill in your Supabase values.
# Website: http://localhost:5174
# API:     http://localhost:5000

# --- Supabase (recommended) ---
# Dashboard → Project Settings → Database → Connection string → URI
# Use Session pooler (port 5432) for this Express server.
# Example:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Required by the API for login tokens
JWT_SECRET=change-this-to-a-long-random-string

# API port
PORT=5000

# --- Local PostgreSQL fallback (used only if DATABASE_URL is empty) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=school_cms
# DB_SSL=false

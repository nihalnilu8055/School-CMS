RewriteEngine On
RewriteBase /

# Keep uploaded media and PHP CMS APIs as real files
RewriteRule ^uploads/ - [L]
RewriteRule ^api/ - [L]
RewriteRule ^data/ - [L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule . /index.html [L]
